[user]
	name = Patrick Barletta
	email = teamdest@pbarletta.com

[core]
	editor = nvim
	pager = delta
	excludesfile = /Users/pbarletta/.gitignore_global

[commit]
	template = /Users/pbarletta/.stCommitMsg

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[init]
	defaultBranch = main

[interactive]
  diffFilter = delta --paging=never --color-only

[include]
	path = ~/.config/delta/themes.gitconfig 

[delta]
  features = catppuccin-mocha decorations
	navigate = true
  side-by-side = true
  hyperlinks = true

[merge]
  tool = vimdiff
	conflictstyle = zdiff3

[diff]
  too = vimdiff
	colormoved = default
  colormovedws = "allow-indentation-change"

[mergetool "vimdiff"]
  cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'

[credential]
	helper = /usr/local/share/gcm-core/git-credential-manager
	helper = osxkeychain

[credential "https://dev.azure.com"]
	useHttpPath = true
